{
  "name": "notedrill",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "dependencies": {
    "@qvac/sdk": "0.20.0",
    "express": "5.2.1",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "scripts": {
    "dev": "node scripts/check-node.mjs && concurrently --kill-others \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "node scripts/check-node.mjs && node scripts/build.mjs",
    "start": "node scripts/check-node.mjs && node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/smoke.ts",
    "test:smoke": "node scripts/probe.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "test:cancel": "tsx scripts/cancellation-live.ts",
    "test:production": "node scripts/api-live.mjs"
  }
}
